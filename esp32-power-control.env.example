# ESP32 远程电源控制服务器配置示例
# 部署时可重命名为 /etc/esp32-power-control.env 或作为容器/进程环境变量加载

# ESP32 轮询通信 Token (需与 ESP32 配网页面的 Token 保持一致)
ESP32_POWER_TOKEN=YOUR_ESP32_POLLING_SECRET_TOKEN

# Web 页面管理 Token (通过浏览器访问 Web 面板输入此口令登录)
ESP32_POWER_WEB_TOKEN=YOUR_WEB_DASHBOARD_SECRET_TOKEN

# 服务监听地址与端口 (建议前面加 Nginx 反代启用 HTTPS)
ESP32_POWER_HOST=0.0.0.0
ESP32_POWER_PORT=8080

# 允许受控的设备标识列表，英文逗号分隔 (如 laptop,desktop)
ESP32_POWER_DEVICES=laptop

# 单次按键命令生命周期（秒），超时未被 ESP32 取走则自动过期废弃
ESP32_POWER_COMMAND_TTL=45

# 防误触/连点冷却时间（秒）
ESP32_POWER_PRESS_COOLDOWN=10
